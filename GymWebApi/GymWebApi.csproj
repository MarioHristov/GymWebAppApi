<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants Condition="'$(SqliteOnly)' != 'true'">$(DefineConstants);SQL_SERVER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" Condition="'$(SqliteOnly)' != 'true'" />
    <Content Update="Clubhouse/catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
